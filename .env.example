# =============================================================================
# Cấu hình build/run cho gs_env.
# Cách nhanh nhất: chạy ./host/setup_host.sh -> tự dò GPU/driver và sinh file .env
# Hoặc: cp .env.example .env rồi sửa tay.
# =============================================================================

# --- CUDA toolkit trong container (phải <= "CUDA Version" mà nvidia-smi hiện) ---
# driver >= 570  -> 12.8.1 + cu128  (bắt buộc với RTX 50xx / Blackwell)
# driver 560-569 -> 12.6.3 + cu126
CUDA_VERSION=12.8.1
TORCH_CUDA=cu128

# --- PyTorch (gsplat/examples hiện pin torch 2.9.1 / torchvision 0.24.1) -----
TORCH_VERSION=2.9.1
TORCHVISION_VERSION=0.24.1

# --- Kiến trúc GPU (compute capability), xem: nvidia-smi --query-gpu=compute_cap --format=csv
# RTX 20xx=7.5 | RTX 30xx/A6000=8.6 | A100=8.0 | RTX 40xx/L40=8.9 | H100=9.0
# RTX 50xx=12.0 | Jetson Orin=8.7 (không dùng image này cho Jetson)
# Nhiều GPU khác loại: CUDA_ARCH=86;89  TORCH_CUDA_ARCH_LIST=8.6;8.9
CUDA_ARCH=86
TORCH_CUDA_ARCH_LIST=8.6

# --- Phiên bản phần mềm ---------------------------------------------------------
COLMAP_VERSION=4.2.1
# Có thể đặt commit hash để cố định phiên bản cho paper (reproducibility)
GSPLAT_REF=main

# --- Số job song song khi compile (mỗi job CUDA ~2-3 GB RAM). Hết RAM -> giảm số này
MAX_JOBS=8

# --- Thư mục làm việc trên host, mount vào /root/ws trong container -------------
WS_DIR=./ws

# --- Chỉ đặt true khi driver < 560 (chạy nhờ CUDA minor-version compatibility) ---
NVIDIA_DISABLE_REQUIRE=false
